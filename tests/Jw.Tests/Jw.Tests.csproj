<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- AddDefaultTokenProviders 等在 ASP.NET Core 共享框架里 -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.15" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NPOI" Version="2.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- 样例图纸（拷贝自旧版仓库 1伏図.jww / 2伏図.jww） -->
    <None Include="testdata\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Jw.Infrastructure\Jw.Infrastructure.csproj" />
    <ProjectReference Include="..\..\tools\LegacyImport\LegacyImport.csproj" />
    <!-- 出力 JWW の比較用（ネイティブの JwwHelper を直接読む） -->
    <Reference Include="JwwHelper"><HintPath>..\..\native\JwwHelper\x64\Release\Output\JwwHelper.dll</HintPath></Reference>
  </ItemGroup>

</Project>
