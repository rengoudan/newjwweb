@using Jw.Application.Customers
@inject CustomerService Service
@inject UiRunner Ui

<MudDialog>
    <DialogContent>
        @if (_model is null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            <EditForm id="customer-form" Model="_model" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <MudStack Spacing="3">
                    <MudTextField @bind-Value="_model.CompanyName" For="() => _model.CompanyName" Label="@L["会社名"]" Required="true"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" AutoFocus="true" />
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_model.Contact" For="() => _model.Contact" Label="@L["担当者"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_model.Telephone" For="() => _model.Telephone" Label="@L["電話番号"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                    </MudGrid>
                    <MudTextField @bind-Value="_model.Address" For="() => _model.Address" Label="@L["住所"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudTextField @bind-Value="_model.Note" For="() => _model.Note" Label="@L["備考"]" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" />
                </MudStack>
            </EditForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">@L["キャンセル"]</MudButton>
        <MudButton ButtonType="ButtonType.Submit" form="customer-form" Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving || _model is null">@L["保存"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid? CustomerId { get; set; }

    private CustomerInput? _model;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        if (CustomerId is null) { _model = new CustomerInput(); return; }
        var ok = await Ui.RunAsync(async () => _model = await Service.GetForEditAsync(CustomerId.Value));
        if (!ok) MudDialog.Cancel();
    }

    private async Task SaveAsync()
    {
        _saving = true;
        var ok = await Ui.RunAsync(() => Service.SaveAsync(_model!), L["保存しました。"]);
        _saving = false;
        if (ok) MudDialog.Close(DialogResult.Ok(true));
    }
}
