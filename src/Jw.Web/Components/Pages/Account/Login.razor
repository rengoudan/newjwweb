@page "/account/login"
@layout AccountLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@using Jw.Application.Auditing
@using Jw.Domain.Auditing
@using Jw.Domain.Identity
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authentication
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject IAuditLogger Audit
@inject NavigationManager Nav

<PageTitle>@L["ログイン"]</PageTitle>

<h1 class="jw-account-title">@L["ログイン"]</h1>

@if (_error is not null)
{
    <div class="jw-alert jw-alert-error">@_error</div>
}

<EditForm Model="Input" FormName="login" OnValidSubmit="LoginAsync" method="post" class="jw-form">
    <DataAnnotationsValidator />
    <label class="jw-field">
        <span>@L["ユーザーID"]</span>
        <InputText @bind-Value="Input!.UserName" autocomplete="username" autofocus />
        <ValidationMessage For="() => Input!.UserName" />
    </label>
    <label class="jw-field">
        <span>@L["パスワード"]</span>
        <InputText type="password" @bind-Value="Input!.Password" autocomplete="current-password" />
        <ValidationMessage For="() => Input!.Password" />
    </label>
    <label class="jw-check">
        <InputCheckbox @bind-Value="Input!.RememberMe" />
        <span>@L["ログイン状態を保持する"]</span>
    </label>
    <button type="submit" class="jw-btn-primary">@L["ログイン"]</button>
</EditForm>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private LoginModel? Input { get; set; }
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private string? _error;

    protected override void OnInitialized() => Input ??= new(); // 首次渲染前就要有模型

    protected override async Task OnInitializedAsync()
    {
        // 打开登录页时清掉残留的外部登录 Cookie
        if (HttpMethods.IsGet(HttpContext.Request.Method))
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
    }

    private async Task LoginAsync()
    {
        var userName = Input!.UserName.Trim();
        var user = await UserManager.FindByNameAsync(userName);
        var result = await SignInManager.PasswordSignInAsync(userName, Input!.Password, Input!.RememberMe, lockoutOnFailure: true);

        if (result.Succeeded && user is not null)
        {
            user.LastLoginAt = DateTime.UtcNow;
            await UserManager.UpdateAsync(user);
            await Audit.LogAsync(new AuditEntry(AuditCategory.Security, AuditActions.Login, "ログイン")
            {
                UserIdOverride = user.Id, UserNameOverride = user.UserName,
                EntityType = nameof(AppUser), EntityId = user.Id.ToString(),
            });
            Nav.NavigateTo(user.MustChangePassword ? "/account/change-password" : SafeReturnUrl(ReturnUrl), forceLoad: true);
            return;
        }

        Input!.Password = ""; // 不把输入过的密码再写回页面
        string reason;
        if (result.IsLockedOut)
        {
            _error = L["ログインに続けて失敗したため、アカウントが一時的にロックされています。しばらくしてから再度お試しください。"];
            reason = "ロック中";
        }
        else if (result.IsNotAllowed)
        {
            _error = L["このアカウントは無効になっています。管理者に連絡してください。"];
            reason = "無効なアカウント";
        }
        else
        {
            _error = L["ユーザーIDまたはパスワードが正しくありません。"];
            reason = user is null ? "存在しないユーザーID" : "パスワード不一致";
        }

        await Audit.LogAsync(new AuditEntry(AuditCategory.Security, AuditActions.LoginFailed, $"ログイン失敗（{reason}）")
        {
            UserIdOverride = user?.Id, UserNameOverride = userName,
            EntityType = nameof(AppUser), EntityId = user?.Id.ToString(),
        });
    }

    /// <summary>只允许跳回本站内的路径，防止被利用做开放重定向。</summary>
    private static string SafeReturnUrl(string? url) =>
        !string.IsNullOrEmpty(url) && url.StartsWith('/') && !url.StartsWith("//") && !url.StartsWith("/\\") ? url : "/";

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "ユーザーIDを入力してください。")]
        public string UserName { get; set; } = "";

        [Required(ErrorMessage = "パスワードを入力してください。")]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }
    }
}
