@page "/account/change-password"
@layout AccountLayout
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@using Jw.Application.Auditing
@using Jw.Domain.Auditing
@using Jw.Domain.Identity
@using Microsoft.AspNetCore.Identity
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject IAuditLogger Audit
@inject NavigationManager Nav

<PageTitle>@L["パスワード変更"]</PageTitle>

<h1 class="jw-account-title">@L["パスワード変更"]</h1>

@if (_mustChange)
{
    <div class="jw-alert jw-alert-info">@L["初回ログインまたはパスワードリセット後のため、新しいパスワードを設定してください。"]</div>
}
@if (_errors.Count > 0)
{
    <div class="jw-alert jw-alert-error">
        @foreach (var e in _errors)
        {
            <div>@e</div>
        }
    </div>
}

<EditForm Model="Input" FormName="change-password" OnValidSubmit="SubmitAsync" method="post" class="jw-form">
    <DataAnnotationsValidator />
    <label class="jw-field">
        <span>@L["現在のパスワード"]</span>
        <InputText type="password" @bind-Value="Input!.OldPassword" autocomplete="current-password" autofocus />
        <ValidationMessage For="() => Input!.OldPassword" />
    </label>
    <label class="jw-field">
        <span>@L["新しいパスワード"]</span>
        <InputText type="password" @bind-Value="Input!.NewPassword" autocomplete="new-password" />
        <small>@L["8文字以上、英小文字と数字を含めてください。"]</small>
        <ValidationMessage For="() => Input!.NewPassword" />
    </label>
    <label class="jw-field">
        <span>@L["新しいパスワード（確認）"]</span>
        <InputText type="password" @bind-Value="Input!.ConfirmPassword" autocomplete="new-password" />
        <ValidationMessage For="() => Input!.ConfirmPassword" />
    </label>
    <button type="submit" class="jw-btn-primary">@L["変更する"]</button>
    @if (!_mustChange)
    {
        <a href="/" class="jw-link-center">@L["キャンセル"]</a>
    }
</EditForm>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private ChangePasswordModel? Input { get; set; }

    private AppUser _user = default!;
    private bool _mustChange;
    private readonly List<string> _errors = [];

    protected override void OnInitialized() => Input ??= new(); // 首次渲染前就要有模型

    protected override async Task OnInitializedAsync()
    {
        _user = await UserManager.GetUserAsync(HttpContext.User) ?? throw new InvalidOperationException("ユーザーが見つかりません。");
        _mustChange = _user.MustChangePassword;
    }

    private async Task SubmitAsync()
    {
        // 取出后清空，出错重新显示页面时不把密码写回 HTML
        var (oldPassword, newPassword) = (Input!.OldPassword, Input.NewPassword);
        Input.OldPassword = Input.NewPassword = Input.ConfirmPassword = "";

        if (newPassword == oldPassword)
        {
            _errors.Add(L["新しいパスワードは現在のパスワードと別のものにしてください。"]);
            return;
        }
        var result = await UserManager.ChangePasswordAsync(_user, oldPassword, newPassword);
        if (!result.Succeeded)
        {
            _errors.AddRange(result.Errors.Select(e => e.Description));
            return;
        }
        _user.MustChangePassword = false;
        await UserManager.UpdateAsync(_user);
        await SignInManager.RefreshSignInAsync(_user); // 重新签发凭据，去掉“必须改密码”标记
        await Audit.LogAsync(new AuditEntry(AuditCategory.Security, AuditActions.ChangePassword, "パスワードを変更")
        {
            EntityType = nameof(AppUser), EntityId = _user.Id.ToString(),
        });
        Nav.NavigateTo("/", forceLoad: true);
    }

    private sealed class ChangePasswordModel
    {
        [Required(ErrorMessage = "現在のパスワードを入力してください。")]
        public string OldPassword { get; set; } = "";

        [Required(ErrorMessage = "新しいパスワードを入力してください。")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "パスワードは8文字以上にしてください。")]
        public string NewPassword { get; set; } = "";

        [Compare(nameof(NewPassword), ErrorMessage = "確認用のパスワードが一致しません。")]
        public string ConfirmPassword { get; set; } = "";
    }
}
