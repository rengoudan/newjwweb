@page "/admin/settings"
@attribute [Authorize(Policy = Permissions.Admin.Settings)]
@using Jw.Application.Floors
@inject ExportService Service
@inject UiRunner Ui

<PageTitle>@L["システム設定"]</PageTitle>

<PageHeader Title="@L["システム設定"]" Description="@L["すべてのユーザーに共通の設定です。変更は操作ログに記録されます。"]" />

<MudPaper Class="jw-card pa-5" Elevation="0" Style="max-width:640px">
    <MudText Typo="Typo.h6" Class="mb-1">@L["出力（JW 図面・梁製造 CSV）"]</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        @L["旧版ではパソコンごとの設定画面（CSV 設定）で変更していた値です。"]
    </MudText>
    @if (_model is null)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <EditForm Model="_model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <MudStack Spacing="3">
                <MudNumericField T="double" @bind-Value="_model.HoleDiameter" For="() => _model.HoleDiameter" Label="@L["孔径（mm）"]"
                                 Step="0.5" Variant="Variant.Outlined" Margin="Margin.Dense"
                                 HelperText="@L["図面の穴の大きさと、梁製造 CSV の孔径列に使います。"]" />
                <MudNumericField T="double" @bind-Value="_model.CsvYAdjust" For="() => _model.CsvYAdjust" Label="@L["梁製造 CSV の Y 方向調整（mm）"]"
                                 Step="0.5" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <div>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving">@L["保存"]</MudButton>
                </div>
            </MudStack>
        </EditForm>
    }
</MudPaper>

@code {
    private ExportSettingsInput? _model;
    private bool _saving;

    protected override async Task OnInitializedAsync() =>
        await Ui.RunAsync(async () => _model = await Service.GetSettingsAsync());

    private async Task SaveAsync()
    {
        _saving = true;
        await Ui.RunAsync(() => Service.SaveSettingsAsync(_model!), L["保存しました。"]);
        _saving = false;
    }
}
