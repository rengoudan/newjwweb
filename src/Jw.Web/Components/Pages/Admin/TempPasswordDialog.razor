@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText Class="mb-3">@L["仮パスワードは今回だけ表示されます。本人に安全な方法で伝えてください。"]</MudText>
        <div class="jw-temp-password">
            <code>@Password</code>
            <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small" OnClick="CopyAsync" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => MudDialog.Close()">@L["閉じる"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string Password { get; set; } = "";

    private async Task CopyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Password);
            Snackbar.Add(L["コピーしました。"], Severity.Info);
        }
        catch (JSException)
        {
            Snackbar.Add(L["コピーできませんでした。手動で選択してコピーしてください。"], Severity.Warning);
        }
    }
}
