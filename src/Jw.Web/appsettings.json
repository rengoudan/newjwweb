{
  "ConnectionStrings": {
    "Default": "Server=.;Database=NewJwWeb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=False"
  },
  "App": {
    "Culture": "ja-JP",
    "TimeZone": "Tokyo Standard Time"
  },
  "Database": {
    "AutoMigrate": true
  },
  "Seed": {
    "AdminUserName": "admin",
    "AdminPassword": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": { "path": "logs/jw-.log", "rollingInterval": "Day", "retainedFileCountLimit": 30 }
      }
    ]
  },
  "AllowedHosts": "*"
}
