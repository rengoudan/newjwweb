<Project Sdk="Microsoft.NET.Sdk">
  <!-- 第0阶段：验证拷贝的 JwwHelper（C++/CLI, .NET 10, x64）能被 .NET 10 加载并读写 jww -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup>
    <JwwHelperDir>$(MSBuildThisFileDirectory)..\..\native\JwwHelper\x64\Release\Output\</JwwHelperDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="JwwHelper">
      <HintPath>$(JwwHelperDir)JwwHelper.dll</HintPath>
    </Reference>
    <None Include="$(JwwHelperDir)Ijwhost.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
